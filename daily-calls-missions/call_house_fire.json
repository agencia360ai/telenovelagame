          "next": "call_house_fire.b3",
          "effects": {
            "trust": -1
          }
        }
      ]
    },
    {
      "id": "call_house_fire.b3",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "caller",
          "text": "I can't get out — it started in my room!"
