      "id": "call_toilet_paper.b4",
      "type": "decision",
      "prompt": "Decide",
      "choices": [
        {
          "id": "call_toilet_paper.b4_0",
          "label": "Ma'am, this line is for emergencies.",
          "next": "call_toilet_paper.b5"
        },
        {
          "id": "call_toilet_paper.b4_1",
          "label": "Sure. Any brand you prefer? 😏",
          "next": "call_toilet_paper.b5",
          "effects": {
            "trust": -1
          }
        }
      ]
    },
    {
      "id": "call_toilet_paper.b5",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "caller",
