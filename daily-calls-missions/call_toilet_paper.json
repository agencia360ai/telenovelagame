        {
          "id": "call_toilet_paper.b2_1",
          "label": "Sorry, wrong number?",
          "next": "call_toilet_paper.b3"
        },
        {
          "id": "call_toilet_paper.b2_2",
          "label": "Then your hand will do it!",
          "next": "call_toilet_paper.b3",
          "effects": {
            "trust": -1
          }
        }
      ]
    },
    {
      "id": "call_toilet_paper.b3",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "caller",
          "text": "Please, I pooped! Can you send some?"
        }
      ],
      "next": "call_toilet_paper.b4"
    },
