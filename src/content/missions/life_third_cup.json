        {
          "speaker": "narrator",
          "text": "The break-room coffee has two settings: jet fuel and regret. The pot is fresh, which means jet fuel."
        },
        {
          "speaker": "narrator",
          "text": "Cup three hovers at the edge of wisdom."
        }
      ],
      "next": "life_third_cup.d1"
    },
    {
      "id": "life_third_cup.d1",
      "type": "decision",
      "prompt": "The pot is watching.",
      "choices": [
        {
          "id": "life_third_cup.d1_0",
          "label": "Pour it. No fear.",
          "next": "life_third_cup.fin_0"
        },
        {
          "id": "life_third_cup.d1_1",
          "label": "Half cup. Diplomacy.",
          "next": "life_third_cup.fin_1"
        },
        {
          "id": "life_third_cup.d1_2",
          "label": "Water instead. Growth.",
          "next": "life_third_cup.fin_2"
