      ]
    },
    {
      "id": "life_third_cup.fin_0",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "Cup three. Your handwriting on the log gets 8% more decisive. Worth it."
        }
      ],
      "next": "_end"
    },
    {
      "id": "life_third_cup.fin_1",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "The compromise of professionals. Alert, not vibrating. The log stays legible."
        }
      ],
      "next": "_end"
    },
    {
