{
  "schema": "mission@1",
  "id": "event_first_date",
  "title": "First Date",
  "version": "2.0.0",
  "locale_default": "en",
  "difficulty": 1,
  "category": "event",
  "caller": {
    "name": "You",
    "type": "OFF DUTY",
    "location": "Small restaurant"
  },
  "reward": 5,
  "order": 50,
  "initial_variables": {
    "love": 0
  },
  "assets": [],
  "initial_flags": {},
  "start": "ev_date1.intro",
  "speakers": {
    "date": "Date"
  },
  "beats": [
    {
      "id": "ev_date1.intro",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "The napkin number turned into a dinner. Small place, candle in a bottle, the kind of nervous that feels good."
        },
        {
          "speaker": "date",
          "text": "So a 911 operator. Do you ever get to say 'what's your emergency' in real life?"
        }
      ],
      "next": "ev_date1.d1"
    },
    {
      "id": "ev_date1.d1",
      "type": "decision",
      "prompt": "The check lands between you.",
      "choices": [
        {
          "id": "ev_date1.d1_0",
          "label": "Take the whole check.",
          "next": "ev_date1.fin_pay",
          "cash_cost": 15,
          "effects": {
            "love": 2
          }
        },
        {
          "id": "ev_date1.d1_1",
          "label": "Split it down the middle.",
          "next": "ev_date1.fin_split",
          "cash_cost": 8,
          "effects": {
            "love": 1
          }
        },
        {
          "id": "ev_date1.d1_2",
          "label": "'You grab this one, I'll get the next.'",
          "next": "ev_date1.fin_next",
          "effects": {
            "love": 1
          }
        }
      ]
    },
    {
      "id": "ev_date1.fin_pay",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "date",
          "text": "Smooth. Okay — next one's on me. And there WILL be a next one."
        },
        {
          "speaker": "narrator",
          "text": "You walk out lighter in the wallet and lighter everywhere else too."
        }
      ],
      "next": "_end"
    },
    {
      "id": "ev_date1.fin_split",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "Half and half, no fuss. 'Fair,' they say, approvingly. Somehow that lands better than a grand gesture."
        }
      ],
      "next": "_end"
    },
    {
      "id": "ev_date1.fin_next",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "'Bold — assuming a second date.' They pay, smiling. On the sidewalk they say it: 'Tuesday works.'"
        }
      ],
      "next": "_end"
    },
    {
      "id": "_end",
      "type": "outcome"
    }
  ]
}