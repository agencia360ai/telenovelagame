{
  "schema": "mission@1",
  "id": "event_night_out",
  "title": "Night Out",
  "version": "2.0.0",
  "locale_default": "en",
  "difficulty": 1,
  "category": "event",
  "caller": {
    "name": "You",
    "type": "OFF DUTY",
    "location": "Group chat"
  },
  "reward": 5,
  "order": 40,
  "initial_variables": {
    "bond": 0,
    "energy": 0
  },
  "assets": [],
  "initial_flags": {},
  "start": "ev_night.intro",
  "speakers": {
    "friend": "Old Friend"
  },
  "beats": [
    {
      "id": "ev_night.intro",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "The group chat wakes up after months asleep. Everyone's asking about you."
        },
        {
          "speaker": "friend",
          "text": "You in?? We're covering the table, everyone throws in for their share."
        }
      ],
      "next": "ev_night.d1"
    },
    {
      "id": "ev_night.d1",
      "type": "decision",
      "prompt": "First invite in a long time.",
      "choices": [
        {
          "id": "ev_night.d1_0",
          "label": "Go. Throw in your share.",
          "next": "ev_night.fin_go",
          "cash_cost": 10,
          "effects": {
            "bond": 2,
            "energy": 1
          }
        },
        {
          "id": "ev_night.d1_1",
          "label": "Go, but just for a soda.",
          "next": "ev_night.fin_soda",
          "cash_cost": 3,
          "effects": {
            "bond": 1
          }
        },
        {
          "id": "ev_night.d1_2",
          "label": "'Next time. Early shift tomorrow.'",
          "next": "ev_night.fin_skip",
          "effects": {
            "bond": -1,
            "energy": 1
          }
        }
      ]
    },
    {
      "id": "ev_night.fin_go",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "Tacos and bad jokes. For three hours you're just a person at a table."
        }
      ],
      "next": "_end"
    },
    {
      "id": "ev_night.fin_soda",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "You nurse one soda and stay two hours anyway."
        }
      ],
      "next": "_end"
    },
    {
      "id": "ev_night.fin_skip",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "The chat posts photos until 1 a.m."
        }
      ],
      "next": "_end"
    },
    {
      "id": "_end",
      "type": "outcome"
    }
  ],
  "offsite": true
}