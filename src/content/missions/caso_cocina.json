        {
          "id": "caso_cocina.d1c_0",
          "label": "And emergencies are what we do 😎",
          "next": "caso_cocina.c_out"
        },
        {
          "id": "caso_cocina.d1c_1",
          "label": "Sorry. Are you out of the house?",
          "next": "caso_cocina.c_out"
        }
      ]
    },
    {
      "id": "caso_cocina.c_water",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "caller",
          "text": "No, it's way too hot!"
        }
      ],
      "next": "caso_cocina.d2"
    },
    {
      "id": "caso_cocina.c_out",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "caller",
          "text": "I can't get out, it's too hot!"
        }
      ],
      "next": "caso_cocina.d2"
    },
    {
      "id": "caso_cocina.d2",
      "type": "decision",
      "prompt": "Instruction",
      "choices": [
        {
          "id": "caso_cocina.d2_0",
          "label": "Get out of the house NOW.",
          "next": "caso_cocina.c_help",
          "effects": {
            "integrity": 1
          }
        },
        {
          "id": "caso_cocina.d2_1",
          "label": "Move away from the fire.",
          "next": "caso_cocina.c_help",
          "effects": {
            "integrity": 1
          }
        },
        {
          "id": "caso_cocina.d2_2",
          "label": "I'm kinda on fire too 🔥",
          "next": "caso_cocina.c_help",
          "effects": {
            "trust": -1
          }
        }
      ]
    },
    {
      "id": "caso_cocina.c_help",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "caller",
          "text": "I need someone, please!"
        }
      ],
      "next": "caso_cocina.d3"
    },
    {
      "id": "caso_cocina.d3",
      "type": "decision",
      "prompt": "Get location",
      "choices": [
        {
          "id": "caso_cocina.d3_0",
          "label": "Send me your location.",
          "next": "caso_cocina.loc"
        },
        {
          "id": "caso_cocina.d3_1",
          "label": "Not just anybody? 😏",
          "next": "caso_cocina.loc",
          "effects": {
            "trust": -1
          }
        }
      ]
    },
    {
      "id": "caso_cocina.loc",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "caller",
          "text": "989 Burb Street."
        }
      ],
      "next": "dispatch"
    },
    {
      "id": "dispatch",
      "type": "dispatch",
      "prompt": "WHO DO YOU DISPATCH?",
      "correct": "firefighters",
      "explanation": "Sirens. The truck rounds the corner before the roof gives. The city breathes a little easier. Citizen trust ticks up. Clean.",
      "next": "_outcome"
    },
    {
      "id": "_outcome",
      "type": "outcome",
      "deploy_media": {
