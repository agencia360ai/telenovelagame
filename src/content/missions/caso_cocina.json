      "next": "caso_cocina.d1"
    },
    {
      "id": "caso_cocina.d1",
      "type": "decision",
      "prompt": "Respond",
      "choices": [
        {
          "id": "caso_cocina.d1_0",
          "label": "Are you out of the house?",
          "next": "caso_cocina.c_out"
        },
        {
          "id": "caso_cocina.d1_1",
          "label": "Can you use water?",
          "next": "caso_cocina.c_water"
        },
        {
          "id": "caso_cocina.d1_2",
          "label": "Your voice sounds kinda sexy.",
          "next": "caso_cocina.d1b",
          "effects": {
            "trust": -1
          }
        }
      ]
    },
    {
      "id": "caso_cocina.d1b",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "caller",
          "text": "WHAT?! This is an EMERGENCY!"
