{
  "schema": "mission@1",
  "id": "w3_plot",
  "title": "Week 3 — Vans at night",
  "version": "2.0.0",
  "locale_default": "en",
  "difficulty": 2,
  "category": "game_plot",
  "week": 3,
  "order": 3,
  "goal_trust": 9,
  "unlock": {
    "minWeek": 3
  },
  "caller": {
    "name": "Edward",
    "type": "STORY CALL",
    "location": "Stadium district"
  },
  "reward": 12,
  "initial_variables": {
    "case_file": 0,
    "love": 0,
    "debt_missed": 0
  },
  "assets": [],
  "initial_flags": {},
  "start": "w3_plot.intro",
  "beats": [
    {
      "id": "w3_plot.intro",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "A neighbor's whisper, hand cupped around the receiver."
        }
      ],
      "variants": [
        {
          "when": {
            "var": "case_file",
            "op": ">=",
            "value": 2
          },
          "lines": [
            {
              "speaker": "narrator",
              "text": "A neighbor's whisper, hand cupped around the receiver. You've been keeping your own map of nights like this — Calder Street, the stadium — and it's starting to fill in."
            }
          ]
        }
      ],
      "next": "w3_plot.v1"
    },
    {
      "id": "w3_plot.v1",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "caller",
          "text": "Hello, this is Edward, I live on the 37th. Vans at 3am appear, I see them every once in a while near the stadium, they are here right now."
        }
      ],
      "next": "w3_plot.d1"
    },
    {
      "id": "w3_plot.d1",
      "type": "decision",
      "prompt": "A real tip. Your authority to dispatch.",
      "choices": [
        {
          "id": "w3_plot.d1_0",
          "label": "Send a unit now.",
          "next": "w3_plot.c_dispatch"
        },
        {
          "id": "w3_plot.d1_1",
          "label": "Take a full statement first.",
          "next": "w3_plot.c_statement",
          "effects": {
            "case_file": 1
          }
        }
      ]
    },
    {
      "id": "w3_plot.c_dispatch",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "A unit rush towards the scene."
        }
      ],
      "next": "w3_plot.d2"
    },
    {
      "id": "w3_plot.c_statement",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "License plates, vehicle details."
        }
      ],
      "next": "w3_plot.d2"
    },
    {
      "id": "w3_plot.d2",
      "type": "decision",
      "prompt": "Final move on the tip",
      "choices": [
        {
          "id": "w3_plot.d2_0",
          "label": "Dispatch anyway. Paperwork later.",
          "next": "w3_plot.fin_dispatch",
          "set_flags": {
            "w3_dispatched": true
          }
        },
        {
          "id": "w3_plot.d2_1",
          "label": "File it the only way the system allows.",
          "next": "w3_plot.fin_soft",
          "set_flags": {
            "w3_filed_away": true
          },
          "effects": {
            "case_file": 1
          }
        }
      ]
    },
    {
      "id": "w3_plot.fin_dispatch",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "The unit reports a vehicle that was full of Stadium Merchandise."
        }
      ],
      "variants": [
        {
          "when": {
            "flag": "w2_documented"
          },
          "lines": [
            {
              "speaker": "narrator",
              "text": "The unit reports a vehicle full of Stadium Merchandise. Your Week 2 notes put the antennas near the stadium too. That's twice now — and twice is a pattern."
            }
          ]
        }
      ],
      "next": "_end"
    },
    {
      "id": "w3_plot.fin_soft",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "You open a case for your supervisor."
        }
      ],
      "next": "_end"
    },
    {
      "id": "_end",
      "type": "outcome"
    }
  ]
}