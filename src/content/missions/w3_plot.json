{
  "schema": "mission@1",
  "id": "w3_plot",
  "title": "Week 3 — The House on Calder",
  "version": "1.0.0",
  "locale_default": "en",
  "difficulty": 2,
  "category": "game_plot",
  "order": 30,
  "caller": {
    "name": "Caller",
    "type": "STORY CALL",
    "location": "Calder Street"
  },
  "reward": 14,
  "initial_variables": {
    "integrity": 0,
    "compliance": 0,
    "don": 0,
    "loose_thread": 0,
    "case_file": 0,
    "pawn": 0,
    "money": 0
  },
  "initial_flags": {},
  "assets": [],
  "start": "w3_plot.intro",
  "beats": [
    {
      "id": "w3_plot.intro",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "A neighbor's whisper, hand cupped around the receiver."
        }
      ],
      "next": "w3_plot.v1"
    },
    {
      "id": "w3_plot.v1",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "caller",
          "text": "The house on Calder. Curtains always shut. Vans at 3am. Girls I never see twice. I'm scared to give my name."
        }
      ],
      "next": "w3_plot.d1"
    },
    {
      "id": "w3_plot.d1",
      "type": "decision",
      "prompt": "A real tip. Your authority to dispatch.",
      "choices": [
        {
          "id": "w3_plot.d1_0",
          "label": "Send a welfare check now, on my authority.",
          "next": "w3_plot.c_dispatch",
          "effects": {
            "integrity": 1,
            "case_file": 1
          }
        },
        {
          "id": "w3_plot.d1_1",
          "label": "Take a full statement first.",
          "next": "w3_plot.c_statement",
          "effects": {
            "case_file": 1,
            "loose_thread": 1
          }
        },
        {
          "id": "w3_plot.d1_2",
          "label": "See what the system lets me file.",
          "next": "w3_plot.c_form",
          "effects": {
            "compliance": 1
          }
        }
      ]
    },
    {
      "id": "w3_plot.c_statement",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "You get it all down — times, plates, descriptions. A spine of a case forms on your screen."
        }
      ],
      "next": "w3_plot.d2"
    },
    {
      "id": "w3_plot.c_dispatch",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "The car's already rolling. You'll write it up after."
        }
      ],
      "next": "w3_plot.fin_dispatch"
    },
    {
      "id": "w3_plot.c_form",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "The intake form won't accept it as anything but a 'noise complaint' without a supervisor override code. No supervisor answers at 3am. The form, very politely, buries it for you."
        }
      ],
      "next": "w3_plot.d2"
    },
    {
      "id": "w3_plot.d2",
      "type": "decision",
      "prompt": "Final move on the tip",
      "choices": [
        {
          "id": "w3_plot.d2_0",
          "label": "Dispatch anyway. Paperwork later.",
          "next": "w3_plot.fin_dispatch",
          "effects": {
            "integrity": 1,
            "case_file": 1,
            "compliance": -1
          }
        },
        {
          "id": "w3_plot.d2_1",
          "label": "File it the only way the system allows.",
          "next": "w3_plot.fin_soft",
          "effects": {
            "compliance": 1,
            "pawn": 1,
            "don": 1
          }
        }
      ]
    },
    {
      "id": "w3_plot.fin_dispatch",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "The unit reports a nervous man who won't open up and a house that's 'just movers.' No arrest — but it's the first official knock on that door, and the quiet on the other end felt it."
        }
      ],
      "next": "_end"
    },
    {
      "id": "w3_plot.fin_soft",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "Filed as noise. Buried in the queue. You tell yourself the system knows the city better than you do. That's exactly what it's built to make you think."
        }
      ],
      "next": "_end"
    },
    {
      "id": "_end",
      "type": "outcome"
    }
  ]
}
