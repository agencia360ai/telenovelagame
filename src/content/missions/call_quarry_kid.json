      "next": "call_quarry_kid.b1"
    },
    {
      "id": "call_quarry_kid.b1",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "caller",
          "text": "My friend went missing by the old quarry. Also — don't laugh — the flashlight flickers when I say his name."
        }
      ],
      "next": "call_quarry_kid.d1"
    },
    {
      "id": "call_quarry_kid.d1",
      "type": "decision",
      "prompt": "Respond",
      "choices": [
        {
          "id": "call_quarry_kid.d1_0",
          "label": "When and where did you last see him?",
          "next": "call_quarry_kid.b2"
        },
        {
          "id": "call_quarry_kid.d1_1",
          "label": "Say the name again. Slowly. 👀",
          "next": "call_quarry_kid.b2"
        }
      ]
    },
    {
      "id": "call_quarry_kid.b2",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "caller",
          "text": "After school, by the fence. We tell each other everything. He'd NEVER just leave. Over."
        }
      ],
      "next": "call_quarry_kid.d2"
    },
    {
      "id": "call_quarry_kid.d2",
      "type": "decision",
      "prompt": "Decide",
      "choices": [
        {
          "id": "call_quarry_kid.d2_0",
          "label": "Stay OUT of the quarry. Units are coming.",
          "next": "call_quarry_kid.b3"
        },
        {
          "id": "call_quarry_kid.d2_1",
          "label": "Keep the walkie on. I want ears out there.",
          "next": "call_quarry_kid.b3"
        }
      ]
    },
    {
      "id": "call_quarry_kid.b3",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "caller",
          "text": "Copy that. Hurry. It's getting dark and the flashlight's doing it again. Over."
        }
      ],
