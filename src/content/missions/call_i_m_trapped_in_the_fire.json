  "version": "1.0.0",
  "locale_default": "en",
  "difficulty": 2,
  "tags": [
    "real",
    "fire"
  ],
  "caller": {
    "name": "Caller",
    "type": "FIRE EMERGENCY",
    "location": "22 Halford Street"
  },
  "units": [
    "firefighters",
    "police",
    "ambulance",
    "no_unit"
  ],
  "reward": 7,
  "time_limit_seconds": 15,
  "initial_variables": {
    "trust": 0,
    "integrity": 0,
    "money": 0
  },
  "initial_flags": {},
