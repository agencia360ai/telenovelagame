      "next": "call_infestation.b1"
    },
    {
      "id": "call_infestation.b1",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "caller",
          "text": "My whole house is infested! Bugs in the walls, the vents, the cereal — everywhere! I can't even walk through the kitchen."
        }
      ],
      "next": "call_infestation.b2"
    },
    {
      "id": "call_infestation.b2",
      "type": "decision",
      "prompt": "Respond",
      "choices": [
        {
          "id": "call_infestation.b2_0",
          "label": "Is anyone having trouble breathing?",
          "next": "call_infestation.b3",
          "effects": {
            "integrity": 1
          }
        },
        {
          "id": "call_infestation.b2_1",
          "label": "Get everyone and the pets outside.",
          "next": "call_infestation.b3",
          "effects": {
            "integrity": 1
          }
        },
        {
          "id": "call_infestation.b2_2",
          "label": "Have you tried moving? 📦",
          "next": "call_infestation.b3",
          "effects": {
            "trust": -1
          }
        }
      ]
    },
    {
      "id": "call_infestation.b3",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "caller",
          "text": "Me, grandma, the kids, and the dog — and a LOT of bugs following us."
        }
      ],
      "next": "call_infestation.b4"
    },
    {
      "id": "call_infestation.b4",
      "type": "decision",
      "prompt": "Decide",
      "choices": [
        {
          "id": "call_infestation.b4_0",
          "label": "Stay out, don't reenter — sending the team.",
          "next": "call_infestation.b5",
          "effects": {
            "integrity": 1
          }
        },
        {
          "id": "call_infestation.b4_1",
          "label": "Seal the doors so they don't spread next door.",
          "next": "call_infestation.b5",
          "effects": {
            "integrity": 1
          }
        },
        {
          "id": "call_infestation.b4_2",
          "label": "Just light a few hundred candles 🕯️",
          "next": "call_infestation.b5",
          "effects": {
            "trust": -1
          }
        }
      ]
    },
    {
      "id": "call_infestation.b5",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "caller",
          "text": "742 Birchwood Road. We'll be on the lawn — the one cloud of bugs you can't miss. Please hurry!"
        }
      ],
      "next": "dispatch"
