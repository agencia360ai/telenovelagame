{
  "schema": "mission@1",
  "id": "event_movie_night",
  "title": "Movie Night",
  "version": "2.0.0",
  "locale_default": "en",
  "difficulty": 1,
  "category": "event",
  "caller": {
    "name": "You",
    "type": "OFF DUTY",
    "location": "Your apartment"
  },
  "reward": 5,
  "order": 80,
  "initial_variables": {
    "love": 0,
    "energy": 0
  },
  "assets": [],
  "initial_flags": {},
  "start": "ev_movie.intro",
  "speakers": {
    "partner": "Partner"
  },
  "beats": [
    {
      "id": "ev_movie.intro",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "First time they see your place. The couch has a dent shaped like your double shifts, and the fridge has… condiments."
        },
        {
          "speaker": "partner",
          "text": "Okay, movie's picked. Food situation?"
        }
      ],
      "next": "ev_movie.d1"
    },
    {
      "id": "ev_movie.d1",
      "type": "decision",
      "prompt": "Host mode: activate.",
      "choices": [
        {
          "id": "ev_movie.d1_0",
          "label": "Order the good takeout.",
          "next": "ev_movie.fin_takeout",
          "cash_cost": 12,
          "effects": {
            "love": 1,
            "energy": 1
          }
        },
        {
          "id": "ev_movie.d1_1",
          "label": "Cook whatever the fridge allows.",
          "next": "ev_movie.fin_cook",
          "effects": {
            "love": 2
          }
        },
        {
          "id": "ev_movie.d1_2",
          "label": "Popcorn. Dinner of champions.",
          "next": "ev_movie.fin_popcorn",
          "cash_cost": 3,
          "effects": {
            "love": 1
          }
        }
      ]
    },
    {
      "id": "ev_movie.fin_takeout",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "The good noodles arrive hot and the movie's forgettable, which is fine — the couch dent fits two."
        }
      ],
      "next": "_end"
    },
    {
      "id": "ev_movie.fin_cook",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "partner",
          "text": "You made THIS out of three condiments and rice?"
        },
        {
          "speaker": "narrator",
          "text": "Dispatcher improvisation, kitchen edition. They ask for seconds. The movie never gets finished."
        }
      ],
      "next": "_end"
    },
    {
      "id": "ev_movie.fin_popcorn",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "Two bowls, extra butter, zero pretension. Halfway in they steal your bowl. You allow it. This is serious, then."
        }
      ],
      "next": "_end"
    },
    {
      "id": "_end",
      "type": "outcome"
    }
  ]
}