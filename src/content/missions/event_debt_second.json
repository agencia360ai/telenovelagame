{
  "schema": "mission@1",
  "id": "event_debt_second",
  "title": "Second Installment",
  "version": "2.0.0",
  "locale_default": "en",
  "difficulty": 1,
  "category": "event",
  "caller": {
    "name": "You",
    "type": "OFF DUTY",
    "location": "Your apartment"
  },
  "reward": 5,
  "order": 62,
  "initial_variables": {
    "debt_paid": 0,
    "debt_missed": 0
  },
  "assets": [],
  "initial_flags": {},
  "start": "ev_debt2.intro",
  "beats": [
    {
      "id": "ev_debt2.intro",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "Second installment. The portal remembers you now — it greets you by your full legal name, the way nothing friendly ever does."
        }
      ],
      "variants": [
        {
          "when": {
            "var": "debt_missed",
            "op": ">=",
            "value": 1
          },
          "lines": [
            {
              "speaker": "narrator",
              "text": "Second installment — plus the one you missed, plus the late fee. The letters have stopped being polite. This one mentions the apartment by address."
            }
          ]
        }
      ],
      "next": "ev_debt2.d1"
    },
    {
      "id": "ev_debt2.d1",
      "type": "decision",
      "prompt": "The balance is watching.",
      "choices": [
        {
          "id": "ev_debt2.d1_0",
          "label": "Pay this month.",
          "next": "ev_debt2.fin_paid",
          "cash_cost": 20,
          "effects": {
            "debt_paid": 1
          }
        },
        {
          "id": "ev_debt2.d1_1",
          "label": "Catch up on everything.",
          "next": "ev_debt2.fin_catchup",
          "cash_cost": 35,
          "effects": {
            "debt_paid": 2,
            "debt_missed": -1
          }
        },
        {
          "id": "ev_debt2.d1_2",
          "label": "Skip it. The city pays badly.",
          "next": "ev_debt2.fin_missed",
          "effects": {
            "debt_missed": 1
          },
          "set_flags": {
            "apartment_at_risk": true
          }
        }
      ]
    },
    {
      "id": "ev_debt2.fin_paid",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "Paid. You eat cheap for a few days and tell yourself it's a diet. The apartment doesn't thank you. It doesn't have to — it stays."
        }
      ],
      "next": "_end"
    },
    {
      "id": "ev_debt2.fin_catchup",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "Everything, plus fees. The red banner disappears. For one night, the account and your conscience are both clean, and the wallet is very, very light."
        }
      ],
      "next": "_end"
    },
    {
      "id": "ev_debt2.fin_missed",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "Skipped. The portal logs it without comment. Machines don't threaten — they schedule."
        }
      ],
      "variants": [
        {
          "when": {
            "var": "debt_missed",
            "op": ">=",
            "value": 2
          },
          "lines": [
            {
              "speaker": "narrator",
              "text": "Two missed now. The next letter won't be a letter. It'll be a notice on the door — the yellow kind the whole hallway can read."
            }
          ]
        }
      ],
      "next": "_end"
    },
    {
      "id": "_end",
      "type": "outcome"
    }
  ]
}