{
  "schema": "mission@1",
  "id": "event_debt_letter",
  "title": "The Letter",
  "version": "2.0.0",
  "locale_default": "en",
  "difficulty": 1,
  "category": "event",
  "caller": {
    "name": "You",
    "type": "OFF DUTY",
    "location": "Your mailbox"
  },
  "reward": 5,
  "order": 5,
  "initial_variables": {
    "debt_paid": 0,
    "debt_missed": 0
  },
  "assets": [
    {
      "role": "ambient",
      "key": "event-letter"
    }
  ],
  "initial_flags": {},
  "start": "ev_debt0.intro",
  "beats": [
    {
      "id": "ev_debt0.intro",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "Bills, flyers, and one official envelope. The loan office found your new address."
        }
      ],
      "next": "ev_debt0.d1"
    },
    {
      "id": "ev_debt0.d1",
      "type": "decision",
      "prompt": "Payments start this month. Miss them and they come after the apartment.",
      "choices": [
        {
          "id": "ev_debt0.d1_0",
          "label": "Pin it to the fridge. You'll pay it.",
          "next": "ev_debt0.fin_plan",
          "set_flags": {
            "debt_active": true
          }
        },
        {
          "id": "ev_debt0.d1_1",
          "label": "Call and argue about the interest.",
          "next": "ev_debt0.fin_call",
          "set_flags": {
            "debt_active": true
          }
        }
      ]
    },
    {
      "id": "ev_debt0.fin_plan",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "The letter goes on the fridge, next to the shift schedule."
        }
      ],
      "next": "_end"
    },
    {
      "id": "ev_debt0.fin_call",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "Forty minutes on hold to hear the interest won't budge."
        }
      ],
      "next": "_end"
    },
    {
      "id": "_end",
      "type": "outcome"
    }
  ],
  "offsite": true
}