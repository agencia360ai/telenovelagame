{
  "schema": "mission@1",
  "id": "event_coffee_place",
  "title": "The Coffee Place",
  "version": "2.0.0",
  "locale_default": "en",
  "difficulty": 1,
  "category": "event",
  "caller": {
    "name": "You",
    "type": "OFF DUTY",
    "location": "Corner café"
  },
  "reward": 5,
  "order": 30,
  "initial_variables": {
    "love": 0,
    "energy": 0
  },
  "assets": [],
  "initial_flags": {},
  "start": "ev_coffee.intro",
  "speakers": {
    "stranger": "Stranger"
  },
  "beats": [
    {
      "id": "ev_coffee.intro",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "The café near the station. Someone at the counter is reading the book you own two copies of."
        },
        {
          "speaker": "stranger",
          "text": "They always burn the espresso here. We keep coming anyway."
        }
      ],
      "next": "ev_coffee.d1"
    },
    {
      "id": "ev_coffee.d1",
      "type": "decision",
      "prompt": "They're talking to you.",
      "choices": [
        {
          "id": "ev_coffee.d1_0",
          "label": "Buy their next coffee.",
          "next": "ev_coffee.fin_buy",
          "cash_cost": 5,
          "effects": {
            "love": 2,
            "energy": 1
          },
          "set_flags": {
            "met_stranger": true,
            "got_number": true
          }
        },
        {
          "id": "ev_coffee.d1_1",
          "label": "'Great book. Terrible espresso.'",
          "next": "ev_coffee.fin_talk",
          "effects": {
            "love": 1,
            "energy": 1
          },
          "set_flags": {
            "met_stranger": true
          }
        },
        {
          "id": "ev_coffee.d1_2",
          "label": "Nod politely and take your cup to go.",
          "next": "ev_coffee.fin_go"
        }
      ]
    },
    {
      "id": "ev_coffee.fin_buy",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "stranger",
          "text": "Okay, burnt espresso tastes better free."
        },
        {
          "speaker": "narrator",
          "text": "You trade a smile and a phone number scribbled on a napkin. The walk home feels shorter."
        }
      ],
      "next": "_end"
    },
    {
      "id": "ev_coffee.fin_talk",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "Twenty minutes about the book, the city, the espresso. No numbers exchanged."
        }
      ],
      "next": "_end"
    },
    {
      "id": "ev_coffee.fin_go",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "You take the cup and the exit. Maybe next time."
        }
      ],
      "next": "_end"
    },
    {
      "id": "_end",
      "type": "outcome"
    }
  ],
  "offsite": true
}