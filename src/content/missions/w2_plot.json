    "location": "Untraceable line"
  },
  "reward": 12,
  "initial_variables": {
    "case_file": 0,
    "love": 0,
    "debt_missed": 0
  },
  "assets": [],
  "initial_flags": {},
  "start": "w2_plot.intro",
  "speakers": {
    "voice": "The Voice"
  },
  "beats": [
    {
      "id": "w2_plot.intro",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "A gruesome voice appears on the Line."
        }
      ],
      "variants": [
        {
          "when": {
            "flag": "w1_police_sent"
          },
          "lines": [
            {
              "speaker": "narrator",
              "text": "A gruesome voice appears on the Line. All week you've told yourself the patrol you sent to Calder Street got there in time. The voice doesn't sound like it agrees."
            }
          ]
        },
        {
          "when": {
            "flag": "w1_called_back"
          },
          "lines": [
            {
              "speaker": "narrator",
              "text": "A gruesome voice appears on the Line. It has the same quality as Calder Street's dead tone — a line someone pulled on purpose."
            }
          ]
        }
      ],
      "next": "w2_plot.v1"
    },
    {
      "id": "w2_plot.v1",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "voice",
          "text": "This city will burn. And you can't stop us."
        }
      ],
      "next": "w2_plot.d1"
    },
    {
      "id": "w2_plot.d1",
      "type": "decision",
      "prompt": "A real tip. Your authority to dispatch.",
      "choices": [
        {
          "id": "w2_plot.d1_0",
          "label": "Send a welfare check now.",
          "next": "w2_plot.fin_dispatch",
          "set_flags": {
            "w2_dispatched": true
          }
        },
        {
          "id": "w2_plot.d1_1",
          "label": "Write a complete report.",
          "next": "w2_plot.fin_report",
          "set_flags": {
            "w2_documented": true
          },
          "effects": {
            "case_file": 1
          }
        },
        {
          "id": "w2_plot.d1_2",
          "label": "Keep him on the line.",
          "next": "w2_plot.fin_trace",
          "set_flags": {
            "w2_traced": true
          },
          "effects": {
            "case_file": 1
          }
        }
      ]
    },
    {
      "id": "w2_plot.fin_dispatch",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "The car's already rolling. You'll write it up after."
        }
      ],
      "next": "w2_plot.tail"
    },
    {
      "id": "w2_plot.fin_report",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "You get it all down — times, cameras active, telephone antennas near possible locations."
        }
      ],
      "next": "w2_plot.tail"
    },
    {
      "id": "w2_plot.fin_trace",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "The voice notices what you plot, and hangs up."
        }
      ],
      "next": "w2_plot.tail"
    },
    {
      "id": "w2_plot.tail",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "voice",
          "text": "One more thing, dispatcher. You sound like someone who's lost something. I collect that sound."
        },
        {
          "speaker": "narrator",
          "text": "The line goes dead. Your coffee has gone cold around your hand."
        }
      ],
      "next": "_end"
    },
    {
      "id": "_end",
      "type": "outcome"
    }
  ]
}