{
  "schema": "mission@1",
  "id": "event_crosstown",
  "title": "The Long Way",
  "version": "1.1.0",
  "locale_default": "en",
  "difficulty": 1,
  "category": "event",
  "order": 34,
  "caller": {
    "name": "You",
    "type": "OFF DUTY",
    "location": "Bus stop"
  },
  "speakers": {
    "stranger": "Stranger"
  },
  "reward": 5,
  "initial_variables": {
    "energy": 0,
    "case_file": 0,
    "loose_thread": 0
  },
  "initial_flags": {},
  "assets": [],
  "start": "ev_cross.intro",
  "beats": [
    {
      "id": "ev_cross.intro",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "Night off."
        },
        {
          "speaker": "narrator",
          "text": "Night market across town. The bus costs what it costs."
        }
      ],
      "next": "ev_cross.d1"
    },
    {
      "id": "ev_cross.d1",
      "type": "decision",
      "prompt": "The evening opens.",
      "choices": [
        {
          "id": "ev_cross.d1_0",
          "label": "Check the bus times.",
          "next": "ev_cross.stop"
        },
        {
          "id": "ev_cross.d1_1",
          "label": "Grab your good jacket.",
          "next": "ev_cross.stop"
        }
      ]
    },
    {
      "id": "ev_cross.stop",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "At the stop, a stranger shares the bench and a bag of chestnuts."
        },
        {
          "speaker": "stranger",
          "text": "Night market tonight."
        }
      ],
      "next": "ev_cross.d2"
    },
    {
      "id": "ev_cross.d2",
      "type": "decision",
      "prompt": "The stranger waits.",
      "choices": [
        {
          "id": "ev_cross.d2_0",
          "label": "That obvious?",
          "next": "ev_cross.bus"
        },
        {
          "id": "ev_cross.d2_1",
          "label": "What's good there?",
          "next": "ev_cross.bus"
        }
      ]
    },
    {
      "id": "ev_cross.bus",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "stranger",
          "text": "Try the dumpling stall by the stadium."
        },
        {
          "speaker": "narrator",
          "text": "Headlights swing the corner. The bus kneels, doors open."
        }
      ],
      "next": "ev_cross.d3"
    },
    {
      "id": "ev_cross.d3",
      "type": "decision",
      "prompt": "Where to?",
      "choices": [
        {
          "id": "ev_cross.d3_0",
          "label": "Cross town. Night market.",
          "cash_cost": 6,
          "next": "ev_cross.fin_market",
          "effects": {
            "energy": 1,
            "loose_thread": 1,
            "case_file": 1
          },
          "set_flags": {
            "crosstown_night": true
          }
        },
        {
          "id": "ev_cross.d3_1",
          "label": "Stay on your block.",
          "next": "ev_cross.fin_home",
          "effects": {
            "energy": 1
          }
        }
      ]
    },
    {
      "id": "ev_cross.fin_market",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "Good food, loud music, streets you've only seen as addresses."
        },
        {
          "speaker": "narrator",
          "text": "The dumplings are real. So is the crowd. You almost relax."
        }
      ],
      "next": "ev_cross.vans"
    },
    {
      "id": "ev_cross.vans",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "Then, past the stadium: vans. Parked in a row, engines running at midnight."
        },
        {
          "speaker": "narrator",
          "text": "You memorize a plate without deciding to. Old habit. New thread."
        }
      ],
      "next": "_end"
    },
    {
      "id": "ev_cross.fin_home",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "Your block, your corner store, your couch."
        },
        {
          "speaker": "narrator",
          "text": "The city stays a voice on a wire. Tonight, that's enough."
        }
      ],
      "next": "_end"
    },
    {
      "id": "_end",
      "type": "outcome"
    }
  ],
  "offsite": true
}
