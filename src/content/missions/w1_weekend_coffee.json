          "label": "Let her in. She's good company.",
          "next": "w1_weekend.fin",
          "effects": {
            "mara_trust": 2
          }
        },
        {
          "id": "w1_weekend.d1_1",
          "label": "Keep it professional.",
          "next": "w1_weekend.fin",
          "effects": {
            "integrity": 1
          }
        },
        {
          "id": "w1_weekend.d1_2",
          "label": "Ask why she really chose this job.",
          "next": "w1_weekend.fin",
          "effects": {
            "loose_thread": 1
