      "type": "dialogue",
      "lines": [
        {
          "speaker": "mara",
          "text": "I mean it about keeping you whole. I burned out two rookies before you. I'm not doing it again."
        }
      ],
      "next": "w1_weekend.d1"
    },
    {
      "id": "w1_weekend.d1",
      "type": "decision",
      "prompt": "Martha, off the clock, being genuinely kind",
      "choices": [
        {
