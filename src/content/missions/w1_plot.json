    },
    {
      "id": "w1_plot.memory",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "Calder Street. You grew up two doors down from that address."
        },
        {
          "speaker": "narrator",
          "text": "Red lights passed your window once and kept going — to the wrong house. You never told anyone at the center."
        }
      ],
      "next": "_end"
