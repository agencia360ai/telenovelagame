          "label": "Can you see them right now?",
          "next": "call_drowning.b3",
          "effects": {
            "integrity": 1
          }
        },
        {
          "id": "call_drowning.b2_1",
          "label": "Don't jump in — are YOU safe?",
          "next": "call_drowning.b3",
          "effects": {
            "integrity": 1
          }
        },
        {
          "id": "call_drowning.b2_2",
          "label": "Just learn to swim 🏊",
          "next": "call_drowning.b3",
          "effects": {
            "trust": -1
          }
        }
      ]
    },
    {
      "id": "call_drowning.b3",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "caller",
          "text": "He came up once! There's a life ring on the dock — should I throw it?!"
        }
      ],
      "next": "call_drowning.b4"
    },
    {
      "id": "call_drowning.b4",
      "type": "decision",
      "prompt": "Instruction",
      "choices": [
        {
          "id": "call_drowning.b4_0",
          "label": "Throw the ring — don't go in after him.",
          "next": "call_drowning.b5",
          "effects": {
            "integrity": 1
          }
        },
        {
          "id": "call_drowning.b4_1",
          "label": "Keep eyes on him. Help is coming.",
          "next": "call_drowning.b5",
          "effects": {
            "integrity": 1
          }
        },
        {
          "id": "call_drowning.b4_2",
          "label": "Film it for the views 📱",
          "next": "call_drowning.b5",
          "effects": {
            "trust": -1
          }
        }
      ]
    },
