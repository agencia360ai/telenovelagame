  "start": "call_riot.b0",
  "beats": [
    {
      "id": "call_riot.b0",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "Radio static, breaking glass, a siren drowned out by the roar of a crowd. An officer's voice cuts through, breathing hard."
        }
      ],
      "next": "call_riot.b1"
    },
    {
      "id": "call_riot.b1",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "caller",
          "text": "Dispatch, this is Unit 12 — riot's gone out of control downtown. I need backup, NOW!"
        }
      ],
      "next": "call_riot.b2"
    },
    {
      "id": "call_riot.b2",
      "type": "decision",
      "prompt": "Respond",
      "choices": [
        {
          "id": "call_riot.b2_0",
          "label": "Copy, Unit 12. What's your situation?",
          "next": "call_riot.b3",
          "effects": {
            "integrity": 1
          }
        },
        {
          "id": "call_riot.b2_1",
          "label": "Are you injured, officer?",
          "next": "call_riot.b3",
          "effects": {
            "integrity": 1
          }
        },
        {
          "id": "call_riot.b2_2",
          "label": "Have you tried asking them nicely?",
          "next": "call_riot.b3",
          "effects": {
            "trust": -1
          }
        }
      ]
    },
    {
      "id": "call_riot.b3",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "caller",
          "text": "Crowd's over a hundred and they've taken the intersection. I'm not injured — I can't hold this alone!"
        }
      ],
      "next": "call_riot.b4"
    },
    {
      "id": "call_riot.b4",
      "type": "decision",
      "prompt": "Instruction",
      "choices": [
        {
          "id": "call_riot.b4_0",
          "label": "Hold your position, backup is inbound.",
          "next": "call_riot.b5",
          "effects": {
            "integrity": 1
          }
        },
        {
          "id": "call_riot.b4_1",
          "label": "Fall back to a safe perimeter and wait.",
          "next": "call_riot.b5",
          "effects": {
            "integrity": 1
          }
        },
        {
          "id": "call_riot.b4_2",
          "label": "Charge in, you've got this!",
          "next": "call_riot.b5",
          "effects": {
            "trust": -1
          }
        }
      ]
    },
    {
      "id": "call_riot.b5",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "caller",
          "text": "Copy. Holding at 5th and Main — send everything you've got, fast!"
        }
      ],
      "next": "dispatch"
    },
    {
      "id": "dispatch",
      "type": "dispatch",
      "prompt": "WHO DO YOU DISPATCH?",
      "correct": "police",
      "explanation": "Backup units rolling to 5th and Main. Hang on, Unit 12 — they're almost there.",
      "next": "outcome"
    },
    {
      "id": "outcome",
      "type": "outcome",
      "deploy_media": {
        "key": "deploy-police",
        "role": "deploy"
      }
    }
  ]
