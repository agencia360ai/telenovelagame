{
  "schema": "mission@1",
  "id": "event_the_question",
  "title": "The Question",
  "version": "2.0.0",
  "locale_default": "en",
  "difficulty": 1,
  "category": "event",
  "caller": {
    "name": "You",
    "type": "OFF DUTY",
    "location": "Fire escape"
  },
  "reward": 5,
  "order": 90,
  "initial_variables": {
    "love": 0,
    "energy": 0
  },
  "assets": [],
  "initial_flags": {},
  "start": "ev_quest.intro",
  "speakers": {
    "partner": "Partner"
  },
  "beats": [
    {
      "id": "ev_quest.intro",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "Late. The city hums below the fire escape. You came home quiet again, and this time they didn't pretend not to notice."
        },
        {
          "speaker": "partner",
          "text": "The job takes pieces of you some nights. Where do they go?"
        }
      ],
      "next": "ev_quest.d1"
    },
    {
      "id": "ev_quest.d1",
      "type": "decision",
      "prompt": "Nobody's ever asked it like that.",
      "choices": [
        {
          "id": "ev_quest.d1_0",
          "label": "Answer honestly. All of it.",
          "next": "ev_quest.fin_open",
          "effects": {
            "love": 2,
            "energy": 1
          }
        },
        {
          "id": "ev_quest.d1_1",
          "label": "'They come back when I'm here.'",
          "next": "ev_quest.fin_sweet",
          "effects": {
            "love": 2
          }
        },
        {
          "id": "ev_quest.d1_2",
          "label": "'I'm fine. Really.'",
          "next": "ev_quest.fin_fine",
          "effects": {
            "love": -1
          }
        }
      ]
    },
    {
      "id": "ev_quest.fin_open",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "You talk until the streetlights buzz off. Voices you couldn't save, ones you did. They hold your coffee so your hands are free to shake. It helps. All of it helps."
        }
      ],
      "next": "_end"
    },
    {
      "id": "ev_quest.fin_sweet",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "It's the truest thing you've said all week, and you both know it. The city hums. Nobody moves for a long time."
        }
      ],
      "next": "_end"
    },
    {
      "id": "ev_quest.fin_fine",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "'Fine.' The word every operator knows means the opposite. They let it go — this time — and the space between you keeps its exact width."
        }
      ],
      "next": "_end"
    },
    {
      "id": "_end",
      "type": "outcome"
    }
  ]
}