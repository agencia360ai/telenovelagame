{
  "schema": "mission@1",
  "id": "w4_plot",
  "title": "Week 4 — The Envelope",
  "version": "1.0.0",
  "locale_default": "en",
  "difficulty": 2,
  "category": "game_plot",
  "order": 40,
  "caller": {
    "name": "Dispatch",
    "type": "STORY",
    "location": "Your console"
  },
  "reward": 15,
  "initial_variables": {
    "integrity": 0,
    "compliance": 0,
    "don": 0,
    "loose_thread": 0,
    "case_file": 0,
    "pawn": 0,
    "money": 0
  },
  "initial_flags": {},
  "assets": [],
  "start": "w4_plot.intro",
  "beats": [
    {
      "id": "w4_plot.intro",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "End of shift. There's an envelope tucked under your keyboard — cash, and a typed note, unsigned: 'For the dispatcher who knows when to look away.'"
        }
      ],
      "next": "w4_plot.d1"
    },
    {
      "id": "w4_plot.d1",
      "type": "decision",
      "prompt": "An envelope of cash. Nobody saw it arrive.",
      "choices": [
        {
          "id": "w4_plot.d1_0",
          "label": "Log it as evidence. Bribery, tampering.",
          "next": "w4_plot.fin_log",
          "effects": {
            "integrity": 1,
            "case_file": 2
          }
        },
        {
          "id": "w4_plot.d1_1",
          "label": "Pocket it. Just this once.",
          "next": "w4_plot.fin_take",
          "effects": {
            "money": 400,
            "don": 2,
            "pawn": 1
          }
        },
        {
          "id": "w4_plot.d1_2",
          "label": "Ask around who left it.",
          "next": "w4_plot.c_ask",
          "effects": {
            "loose_thread": 1
          }
        }
      ]
    },
    {
      "id": "w4_plot.c_ask",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "Nobody knows anything. No camera caught it. Just shrugs, and the same unspoken arithmetic everyone here already runs: the people who don't make waves stay whole. Turn it in, and you're telling the building you're a wave."
        }
      ],
      "next": "w4_plot.d2"
    },
    {
      "id": "w4_plot.d2",
      "type": "decision",
      "prompt": "You understand the offer now — and that no one's hand is on it.",
      "choices": [
        {
          "id": "w4_plot.d2_0",
          "label": "Turn it in anyway.",
          "next": "w4_plot.fin_log",
          "effects": {
            "integrity": 2,
            "case_file": 2
          }
        },
        {
          "id": "w4_plot.d2_1",
          "label": "Keep it. Be safe.",
          "next": "w4_plot.fin_take",
          "effects": {
            "money": 400,
            "don": 2,
            "pawn": 2
          }
        }
      ]
    },
    {
      "id": "w4_plot.fin_log",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "You bag it, photograph it, log it. Your hands shake. Now there's paper that says someone paid you to look away — and you said no."
        }
      ],
      "next": "_end"
    },
    {
      "id": "w4_plot.fin_take",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "The cash goes in your jacket. Warm, heavy, easy. You just learned the price of looking away. So did the building."
        }
      ],
      "next": "_end"
    },
    {
      "id": "_end",
      "type": "outcome"
    }
  ]
}
