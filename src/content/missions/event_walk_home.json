{
  "schema": "mission@1",
  "id": "event_walk_home",
  "title": "The Walk Home",
  "version": "2.0.0",
  "locale_default": "en",
  "difficulty": 1,
  "category": "event",
  "caller": {
    "name": "You",
    "type": "OFF DUTY",
    "location": "Night streets"
  },
  "reward": 5,
  "order": 60,
  "initial_variables": {
    "love": 0,
    "energy": 0
  },
  "assets": [],
  "initial_flags": {},
  "start": "ev_walk.intro",
  "speakers": {
    "date": "Date"
  },
  "beats": [
    {
      "id": "ev_walk.intro",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "Second date, no restaurant this time — just the long way home."
        },
        {
          "speaker": "date",
          "text": "You went quiet at that corner. Rough call once?"
        }
      ],
      "next": "ev_walk.d1"
    },
    {
      "id": "ev_walk.d1",
      "type": "decision",
      "prompt": "They noticed.",
      "choices": [
        {
          "id": "ev_walk.d1_0",
          "label": "Tell them the truth — a little of it.",
          "next": "ev_walk.fin_open",
          "effects": {
            "love": 2
          }
        },
        {
          "id": "ev_walk.d1_1",
          "label": "'Long story. Another night.'",
          "next": "ev_walk.fin_later",
          "effects": {
            "love": 1
          }
        },
        {
          "id": "ev_walk.d1_2",
          "label": "Change the subject with a joke.",
          "next": "ev_walk.fin_joke"
        }
      ]
    },
    {
      "id": "ev_walk.fin_open",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "You tell it plainly, no drama. They don't flinch, don't pity — they just move a half step closer for the rest of the walk."
        }
      ],
      "next": "_end"
    },
    {
      "id": "ev_walk.fin_later",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "date",
          "text": "Deal. I collect long stories."
        },
        {
          "speaker": "narrator",
          "text": "A promise shaped like a door left open."
        }
      ],
      "next": "_end"
    },
    {
      "id": "ev_walk.fin_joke",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "The joke lands, the laugh is real, and the corner stays yours alone. Some walls take longer than others."
        }
      ],
      "next": "_end"
    },
    {
      "id": "_end",
      "type": "outcome"
    }
  ],
  "offsite": true
}