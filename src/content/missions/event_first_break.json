{
  "schema": "mission@1",
  "id": "event_first_break",
  "title": "First Break",
  "version": "2.0.0",
  "locale_default": "en",
  "difficulty": 1,
  "category": "event",
  "caller": {
    "name": "You",
    "type": "BREAK",
    "location": "Break room"
  },
  "reward": 5,
  "order": 10,
  "initial_variables": {
    "energy": 0,
    "money_spent": 0
  },
  "assets": [],
  "initial_flags": {},
  "start": "event_break1.intro",
  "beats": [
    {
      "id": "event_break1.intro",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "First break of the shift. The vending machine hums, the microwave light flickers, and your stomach files a formal complaint."
        }
      ],
      "next": "event_break1.d1"
    },
    {
      "id": "event_break1.d1",
      "type": "decision",
      "prompt": "Your break. Your wallet.",
      "choices": [
        {
          "id": "event_break1.d1_0",
          "label": "Buy some nuts.",
          "next": "event_break1.fin_nuts",
          "cash_cost": 5,
          "effects": {
            "energy": 1
          }
        },
        {
          "id": "event_break1.d1_1",
          "label": "Buy a proper dinner.",
          "next": "event_break1.fin_dinner",
          "cash_cost": 12,
          "effects": {
            "energy": 2
          }
        },
        {
          "id": "event_break1.d1_2",
          "label": "Just water. Save the money.",
          "next": "event_break1.fin_water"
        }
      ]
    },
    {
      "id": "event_break1.fin_nuts",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "A bag of nuts from the vending machine. Not a meal, but your hands stop shaking halfway through the next call."
        }
      ],
      "next": "_end"
    },
    {
      "id": "event_break1.fin_dinner",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "A real plate, hot food, ten quiet minutes. You walk back to the console feeling like a person again."
        }
      ],
      "next": "_end"
    },
    {
      "id": "event_break1.fin_water",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "Tap water in a paper cup. Free, cold, and loud in an empty stomach. The city doesn't care if you ate."
        }
      ],
      "next": "_end"
    },
    {
      "id": "_end",
      "type": "outcome"
    }
  ]
}