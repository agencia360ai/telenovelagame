{
  "schema": "mission@1",
  "id": "event_debt_deadline",
  "title": "The Deadline",
  "version": "2.0.0",
  "locale_default": "en",
  "difficulty": 1,
  "category": "event",
  "caller": {
    "name": "You",
    "type": "OFF DUTY",
    "location": "Your apartment"
  },
  "reward": 5,
  "order": 92,
  "initial_variables": {
    "debt_paid": 0,
    "debt_missed": 0
  },
  "assets": [],
  "initial_flags": {},
  "start": "ev_debt3.intro",
  "beats": [
    {
      "id": "ev_debt3.intro",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "Final installment. One more payment and they are off your back."
        }
      ],
      "variants": [
        {
          "when": {
            "var": "debt_missed",
            "op": ">=",
            "value": 2
          },
          "lines": [
            {
              "speaker": "narrator",
              "text": "A notice on your door. The yellow kind. Pay what's owed by Friday, or the apartment stops being yours. The hallway pretends it didn't read it. It read it."
            }
          ]
        },
        {
          "when": {
            "flag": "took_envelope"
          },
          "lines": [
            {
              "speaker": "narrator",
              "text": "Final installment. You have the money — you've had it since the envelope. It spends like any other money. You tell yourself that twice."
            }
          ]
        }
      ],
      "next": "ev_debt3.d1"
    },
    {
      "id": "ev_debt3.d1",
      "type": "decision",
      "prompt": "Friday is not moving.",
      "choices": [
        {
          "id": "ev_debt3.d1_0",
          "label": "Pay the installment.",
          "next": "ev_debt3.fin_cleared",
          "cash_cost": 25,
          "effects": {
            "debt_paid": 1
          },
          "set_flags": {
            "debt_cleared": true
          }
        },
        {
          "id": "ev_debt3.d1_1",
          "label": "Pay EVERYTHING you owe.",
          "next": "ev_debt3.fin_all",
          "cash_cost": 45,
          "effects": {
            "debt_paid": 2,
            "debt_missed": -2
          },
          "set_flags": {
            "debt_cleared": true
          }
        },
        {
          "id": "ev_debt3.d1_2",
          "label": "You can't pay. Face it.",
          "next": "ev_debt3.fin_lost",
          "effects": {
            "debt_missed": 1
          },
          "set_flags": {
            "apartment_lost": true
          }
        }
      ]
    },
    {
      "id": "ev_debt3.fin_cleared",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "PAID — The apartment is yours. You stand in the kitchen a while, just because you can."
        }
      ],
      "next": "_end"
    },
    {
      "id": "ev_debt3.fin_all",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "All of it, fees included. You screenshot it. Some trophies are just receipts."
        }
      ],
      "next": "_end"
    },
    {
      "id": "ev_debt3.fin_lost",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "You box what matters in two trips. A friend's couch, for now."
        }
      ],
      "next": "_end"
    },
    {
      "id": "_end",
      "type": "outcome"
    }
  ],
  "offsite": true
}