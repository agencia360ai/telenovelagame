            { "speaker": "narrator", "text": "Pay by Friday or the apartment stops being yours." }
          ]
        },
        {
          "when": { "flag": "took_envelope" },
          "lines": [
            { "speaker": "narrator", "text": "Final installment. You have the money — you've had it since the envelope." },
