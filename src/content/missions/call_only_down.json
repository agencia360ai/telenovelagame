          "label": "How long have you been in the building?",
          "next": "call_only_down.b2"
        },
        {
          "id": "call_only_down.d1_1",
          "label": "Your TEAM says what?",
          "next": "call_only_down.b2"
        }
      ]
    },
    {
      "id": "call_only_down.b2",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "caller",
          "text": "What year is it out there? We have a quarterly party if I reach my numbers. There's melon."
        }
      ],
      "next": "call_only_down.d2"
    },
    {
      "id": "call_only_down.d2",
      "type": "decision",
      "prompt": "Decide",
      "choices": [
        {
          "id": "call_only_down.d2_0",
          "label": "Stay by the elevator. I'm sending someone in.",
          "next": "call_only_down.b3"
        },
        {
          "id": "call_only_down.d2_1",
          "label": "Take the melon and RUN. 😏",
