          "speaker": "narrator",
          "text": "For half a second you're nine years old again — a corded phone, rain on the glass, a busy signal that never ends."
        },
        {
          "speaker": "narrator",
          "text": "You know why you're here. You've always known."
        }
      ],
      "next": "prologue.sys"
    },
    {
      "id": "prologue.sys",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "A prank? You have to tell the difference."
        }
      ],
      "next": "prologue.d1"
    },
    {
      "id": "prologue.d1",
      "type": "decision",
      "prompt": "First night. What do you tell yourself?",
      "choices": [
        {
          "id": "prologue.d1_0",
          "label": "I'm here to help all of them.",
          "next": "prologue.fin"
        },
        {
          "id": "prologue.d1_1",
          "label": "Learn the job.",
          "next": "prologue.fin"
        },
        {
          "id": "prologue.d1_2",
          "label": "Whatever keeps the paycheck coming.",
          "next": "prologue.fin"
