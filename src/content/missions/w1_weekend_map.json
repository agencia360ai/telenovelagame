      "lines": [
        {
          "speaker": "narrator",
          "text": "Domingo. Sin turnos, sin radio, sin llamadas. Por primera vez en la semana el día es tuyo. Abres el mapa: la ciudad entera cabe en una decisión."
        }
      ],
      "next": "mapa"
    },
    {
      "id": "mapa",
      "type": "map",
      "prompt": "¿A dónde quieres ir hoy?",
      "map": "manhattan2",
      "pins": [
        {
          "id": "feria",
          "x": 0.75,
          "y": 0.36,
          "icon": "🎡",
          "label": "Feria (Este)",
          "set_flags": { "visito_feria": true },
          "effects": { "animo": 2 },
          "next": "feria_intro"
        },
        {
          "id": "hospital",
          "x": 0.4,
          "y": 0.52,
          "icon": "🏥",
          "label": "Hospital (Oeste)",
          "set_flags": { "visito_hospital": true },
