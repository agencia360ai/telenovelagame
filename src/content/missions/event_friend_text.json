{
  "schema": "mission@1",
  "id": "event_friend_text",
  "title": "A Text From an Old Friend",
  "version": "2.0.0",
  "locale_default": "en",
  "difficulty": 1,
  "category": "event",
  "caller": {
    "name": "You",
    "type": "OFF DUTY",
    "location": "Locker room"
  },
  "reward": 5,
  "order": 20,
  "initial_variables": {
    "bond": 0,
    "energy": 0
  },
  "assets": [],
  "initial_flags": {},
  "start": "ev_friend1.intro",
  "speakers": {
    "friend": "Old Friend"
  },
  "beats": [
    {
      "id": "ev_friend1.intro",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "Shift's over. Your phone buzzes — a name you haven't seen in a while."
        },
        {
          "speaker": "friend",
          "text": "Heard you're working the 911 lines now?? Wanna catch up sometime?"
        }
      ],
      "next": "ev_friend1.d1"
    },
    {
      "id": "ev_friend1.d1",
      "type": "decision",
      "prompt": "An old friend, out of nowhere.",
      "choices": [
        {
          "id": "ev_friend1.d1_0",
          "label": "Yes! Grab a bite right now — my treat.",
          "next": "ev_friend1.fin_bite",
          "cash_cost": 8,
          "effects": {
            "bond": 2,
            "energy": 1
          },
          "set_flags": {
            "friend_close": true
          }
        },
        {
          "id": "ev_friend1.d1_1",
          "label": "Reply: 'Soon, I promise.'",
          "next": "ev_friend1.fin_soon",
          "effects": {
            "bond": 1
          }
        },
        {
          "id": "ev_friend1.d1_2",
          "label": "Leave it on read. Too tired.",
          "next": "ev_friend1.fin_read",
          "effects": {
            "bond": -1
          },
          "set_flags": {
            "friend_ignored": true
          }
        }
      ]
    },
    {
      "id": "ev_friend1.fin_bite",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "Two burgers, one hour, five years covered."
        }
      ],
      "next": "_end"
    },
    {
      "id": "ev_friend1.fin_soon",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "'Soon.' A thumbs up comes back."
        }
      ],
      "next": "_end"
    },
    {
      "id": "ev_friend1.fin_read",
      "type": "dialogue",
      "lines": [
        {
          "speaker": "narrator",
          "text": "The message sits there, read and unanswered."
        }
      ],
      "next": "_end"
    },
    {
      "id": "_end",
      "type": "outcome"
    }
  ],
  "offsite": true
}